# Backend local
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# local: SQLite + auth tự quản + thư mục file. Production: postgres + supabase + r2.
PERSISTENCE_BACKEND=sqlite
AUTH_BACKEND=local
IMAGE_STORAGE=local
AUTH_SESSION_DAYS=30
# Email admin cho phép bootstrap, phân tách bằng dấu phẩy. Tài khoản còn phải có app_metadata.role=admin ở Supabase.
ADMIN_EMAILS=
# Production HTTPS mặc định bật Secure khi NODE_ENV=production; local HTTP đặt false.
COOKIE_SECURE=false
TRUST_PROXY_HOPS=
API_REQUESTS_PER_MINUTE=600
API_RATE_LIMIT_BURST=120
# Trần chung theo IP cho mọi phiên (mặc định gấp 4 giới hạn mỗi phiên), chặn xoay vòng token giả.
API_IP_REQUESTS_PER_MINUTE=
API_IP_RATE_LIMIT_BURST=
AUTH_LOGIN_ACCOUNT_PER_15_MIN=10
AUTH_LOGIN_IP_PER_15_MIN=60
AUTH_REGISTER_IP_PER_HOUR=20
AUTH_RESET_ACCOUNT_PER_15_MIN=5
AUTH_RESET_IP_PER_15_MIN=30
AI_REQUESTS_PER_15_MIN=10
# Chỉ cấu hình tạm khi cần nhận dữ liệu local từ bản cũ. Dùng chuỗi ngẫu nhiên dài rồi xoá sau khi claim.
LEGACY_DATA_CLAIM_TOKEN=

# Production persistence (Supabase PostgreSQL/Auth)
DATABASE_URL=
DATABASE_POOL_MAX=5
# Thời hạn mỗi query (ms). Query treo sẽ báo lỗi thay vì giữ kết nối mãi.
DATABASE_QUERY_TIMEOUT_MS=20000
# Base64 của certificate tải từ Supabase Database Settings → SSL Configuration.
DATABASE_CA_CERT_BASE64=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chỉ backend dùng để xóa tài khoản Auth; không đưa vào VITE_/EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Production image storage (private Cloudflare R2 bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=production
# Tuỳ chọn nếu bucket dùng custom/public domain HTTPS.
R2_PUBLIC_URL=
# URL đọc ảnh R2 được ký ngắn hạn; byte ảnh đi thẳng R2 → client, không qua Render.
R2_SIGNED_READ_TTL_SECONDS=300

# Giai đoạn 3: chỉ cấu hình API key ở backend, tuyệt đối không dùng tiền tố VITE_.
IMAGE_PROVIDER=openrouter
MOCK_DELAY_MS=2000
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-3-image-klein
OPENROUTER_IMAGE_RESOLUTION=768
OPENROUTER_IMAGE_ASPECT_RATIO=4:5
OPENROUTER_TIMEOUT_MS=120000
AI_MAX_CONCURRENCY=1
AI_MAX_WAITING_REQUESTS=4
# Trần tổng số request AI (tách đồ + tạo ảnh) của toàn hệ thống mỗi 24 giờ để chặn chi phí bất thường. Bỏ trống = tắt.
AI_DAILY_REQUEST_LIMIT=
AI_QUEUE_TIMEOUT_MS=30000
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TIMEOUT_MS=120000
APP_BASE_URL=http://127.0.0.1:8787
# Đăng nhập bằng Google. Cần AUTH_BACKEND=supabase; đặt cả hai giá trị để bật nút "Tiếp tục với Google" (web + mobile);
# OAuth client (loại Web application) phải có Authorized redirect URI <APP_BASE_URL>/api/auth/oauth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deep link app mobile được phép nhận lại sau khi đăng nhập Google (phân tách bằng dấu phẩy).
# Khi chạy Expo Go, thêm địa chỉ exp:// mà `npx expo start` in ra, ví dụ exp://192.168.1.5:8081/--/auth-callback
MOBILE_AUTH_REDIRECT_URLS=fitsy://auth-callback
MUAPI_API_KEY=

# Shopee Affiliate Open API (server-only). AppId + Secret lấy trong trang Open API của Shopee Affiliate.
# Secret tương đương mật khẩu: không đưa vào VITE_/EXPO_PUBLIC_, không commit.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
# Mặc định https://open-api.affiliate.shopee.vn/graphql; đổi nếu trang tài liệu của bạn ghi URL khác.
SHOPEE_AFFILIATE_ENDPOINT=

# Billing (server-only). Leave a provider blank to disable its checkout button.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

MOMO_ENVIRONMENT=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Optional overrides. Defaults to MoMo e-wallet checkout and the endpoint matching MOMO_ENVIRONMENT.
MOMO_REQUEST_TYPE=captureWallet
MOMO_ENDPOINT=
