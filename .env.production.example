# Server only. Never copy these values into VITE_* or EXPO_PUBLIC_*.
NODE_ENV=production
HOST=0.0.0.0
APP_BASE_URL=https://YOUR_BACKEND_DOMAIN
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
PERSISTENCE_BACKEND=postgres
AUTH_BACKEND=supabase
IMAGE_STORAGE=r2
DATABASE_URL=
DATABASE_CA_CERT_BASE64=
DATABASE_POOL_MAX=5
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=production
IMAGE_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Verify model availability and terms in your provider account.
OPENROUTER_IMAGE_MODEL=
OPENROUTER_IMAGE_RESOLUTION=768
OPENROUTER_IMAGE_ASPECT_RATIO=4:5
OPENROUTER_TIMEOUT_MS=120000
AI_MAX_CONCURRENCY=2
AI_MAX_WAITING_REQUESTS=4
AI_QUEUE_TIMEOUT_MS=15000
# Choose this deliberately against your usage budget.
AI_DAILY_REQUEST_LIMIT=100
MOBILE_AUTH_REDIRECT_URLS=tryoh://auth-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
